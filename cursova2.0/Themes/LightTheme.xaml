<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== ФОНИ ===== -->
    <SolidColorBrush x:Key="BackgroundPrimary"   Color="#F5F6F8"/>
    <SolidColorBrush x:Key="BackgroundSecondary" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BackgroundCard"      Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBorder"          Color="#E2E5EB"/>
    <SolidColorBrush x:Key="CardHover"           Color="#F0F2F5"/>
    <SolidColorBrush x:Key="BorderLight"         Color="#D0D4DC"/>

    <!-- ===== САЙДБАР ===== -->
    <SolidColorBrush x:Key="SidebarBackground" Color="#FAFBFC"/>
    <SolidColorBrush x:Key="SidebarHover"      Color="#EFF1F4"/>
    <SolidColorBrush x:Key="SidebarSelected"   Color="#E5E8EC"/>
    <SolidColorBrush x:Key="SidebarCard"       Color="#FFFFFF"/>

    <!-- ===== АКЦЕНТ ===== -->
    <SolidColorBrush x:Key="AccentColor" Color="#D18E00"/>
    <SolidColorBrush x:Key="AccentHover" Color="#E5A00D"/>
    <SolidColorBrush x:Key="AccentDeep"  Color="#A86E00"/>
    <SolidColorBrush x:Key="AccentText"  Color="#FFFFFF"/>

    <!-- ===== ТЕКСТ ===== -->
    <!-- ТЕКСТ (у світлій темі — темний) -->
    <SolidColorBrush x:Key="TextPrimaryLight"   Color="#141820"/>
    <!-- основний текст на світлому -->
    <SolidColorBrush x:Key="TextSecondaryLight" Color="#5A6170"/>
    <!-- другорядний -->
    <SolidColorBrush x:Key="TextPrimaryDark"    Color="#141820"/>
    <!-- те саме -->
    <SolidColorBrush x:Key="TextSecondaryDark"  Color="#5A6170"/>
    <!-- те саме -->
    <SolidColorBrush x:Key="TextMutedDark"      Color="#8A92A0"/>
    <!-- приглушений -->

    <!-- ===== ІНШЕ ===== -->
    <SolidColorBrush x:Key="BorderColor"      Color="#E2E5EB"/>
    <SolidColorBrush x:Key="InputBackground"  Color="#F0F2F5"/>
    <SolidColorBrush x:Key="DangerColor"      Color="#E5484D"/>

    <!-- ===== СТАТУСИ БЕЗПЕКИ ===== -->
    <SolidColorBrush x:Key="StatusSafeBackground"       Color="#E6F5EC"/>
    <SolidColorBrush x:Key="StatusSuspiciousBackground" Color="#FFF4D6"/>
    <SolidColorBrush x:Key="StatusDangerousBackground"  Color="#FDE8EA"/>
    <SolidColorBrush x:Key="StatusSafeForeground"       Color="#1E7A4C"/>
    <SolidColorBrush x:Key="StatusSuspiciousForeground" Color="#8A5A00"/>
    <SolidColorBrush x:Key="StatusDangerousForeground"  Color="#B01722"/>

    <!-- ===== БЕЙДЖ УСПІХУ ===== -->
    <SolidColorBrush x:Key="BadgeSuccessBackground" Color="#E6F5EC"/>
    <SolidColorBrush x:Key="BadgeSuccessForeground" Color="#1E7A4C"/>

    <!-- ===== ІНФО-БЛОК ===== -->
    <SolidColorBrush x:Key="InfoBlockBackground" Color="#FFF4D6"/>


    <SolidColorBrush x:Key="TitleBarBorder" Color="#000000"/>


</ResourceDictionary>