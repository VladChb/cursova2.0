<Window x:Class="MediaVault.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MediaVault"
        xmlns:converters="clr-namespace:MediaVault.Converters"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="MediaVault" 
        WindowState="Normal"
        ResizeMode="CanResize"
        MinHeight="650" 
        MinWidth="1000"
        Height="768"
        Width="1280"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome 
            CaptionHeight="44"
            ResizeBorderThickness="12"
            GlassFrameThickness="0"
            CornerRadius="0"
            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- КОНВЕРТЕРИ -->
        <converters:RatingToVisibilityConverter x:Key="RatingToVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <!-- БАЗОВІ КОЛЬОРИ -->
        <SolidColorBrush x:Key="BackgroundPrimary" Color="#FF0D0D0D"/>
        <SolidColorBrush x:Key="BackgroundSecondary" Color="#FF1A1A1A"/>
        <SolidColorBrush x:Key="BackgroundCard" Color="#FF2C2C2C"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FFC05A5A"/>
        <SolidColorBrush x:Key="AccentHover" Color="#FFD06A6A"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#FFAAAAAA"/>
        <SolidColorBrush x:Key="TextMuted" Color="#FF666666"/>
        <SolidColorBrush x:Key="BorderColor" Color="#FF333333"/>

        <!-- СТИЛЬ СКРОЛБАРУ -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Background="#FF444444" Height="40">
                                        <Thumb.Resources>
                                            <Style TargetType="Thumb">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Border Background="{TemplateBinding Background}" 
                                                                    CornerRadius="2" 
                                                                    Margin="2"/>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Thumb.Resources>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- СТИЛЬ КАРТКИ -->
        <Style x:Key="MediaCardStyle" TargetType="Border">
            <Setter Property="Width" Value="185"/>
            <Setter Property="Height" Value="290"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="{StaticResource BackgroundCard}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" Opacity="0.3" ShadowDepth="3" BlurRadius="6"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF333333"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="Black" Opacity="0.7" ShadowDepth="8" BlurRadius="15"/>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="1.04" ScaleY="1.04"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- СТИЛЬ КАТЕГОРІЙ -->
        <Style x:Key="CategoryItemStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="6,2"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#30FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SelectedCategoryStyle" TargetType="Border" BasedOn="{StaticResource CategoryItemStyle}">
            <Setter Property="Background" Value="#25FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentColor}"/>
            <Setter Property="BorderThickness" Value="0,0,3,0"/>
        </Style>

        <!-- СТИЛЬ PRIMARY КНОПКИ -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- СТИЛЬ ІКОНКОВОЇ КНОПКИ -->
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF333333"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="38"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF444444"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- СТИЛЬ КНОПОК ВІКНА -->
        <Style x:Key="WindowButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF3A3A3A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFE81123"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- СТИЛЬ КАТЕГОРІЙ ЯК КНОПКИ -->
        <Style x:Key="CategoryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8" 
                                Margin="0">
                            <ContentPresenter HorizontalAlignment="Left" 
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#30FFFFFF"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#40FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- СТИЛЬ ВИБРАНОЇ КАТЕГОРІЇ -->
        <Style x:Key="SelectedCategoryButtonStyle" TargetType="Button" BasedOn="{StaticResource CategoryButtonStyle}">
            <Setter Property="Background" Value="#25FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentColor}"/>
            <Setter Property="BorderThickness" Value="0,0,3,0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#35FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- СТИЛЬ ПОЛЯ ПОШУКУ -->
        <Style x:Key="SearchTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#FF333333"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,0,10,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" CornerRadius="20">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Background" Value="#FF3A3A3A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- СТИЛЬ БЕЙДЖА -->
        <Style x:Key="BadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource AccentColor}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>

        <!-- СТИЛЬ COMBOBOX -->
        <Style x:Key="SortComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#FF333333"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Width" Value="150"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <!-- ГОЛОВНИЙ КОНТЕЙНЕР З ЗАОКРУГЛЕНИМИ КУТАМИ -->
    <Border Background="{StaticResource BackgroundPrimary}" 
            CornerRadius="12"
            BorderBrush="{StaticResource BorderColor}"
            BorderThickness="1"
            Margin="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ЗАГОЛОВОК ВІКНА (кастомний) -->
            <Border Grid.Row="0" 
                    Background="{StaticResource BackgroundSecondary}" 
                    CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Логотип -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="16,0">
                        <Border Width="28" Height="28" Background="{StaticResource AccentColor}" CornerRadius="6" Margin="0,0,10,0">
                            <TextBlock Text="⚡" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="MediaVault" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Кнопки керування вікном -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,8,0">
                        <Button Content="─" 
                                Style="{StaticResource WindowButtonStyle}" 
                                Click="MinimizeWindow_Click"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button Content="☐" 
                                Style="{StaticResource WindowButtonStyle}" 
                                Click="MaximizeWindow_Click"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button Content="✕" 
                                Style="{StaticResource CloseButtonStyle}" 
                                Click="CloseWindow_Click"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ОСНОВНА ЧАСТИНА -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="200" MaxWidth="280"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ЛІВА ПАНЕЛЬ -->
                <Border Grid.Column="0" 
                        Background="{StaticResource BackgroundSecondary}" 
                        BorderBrush="{StaticResource BorderColor}" 
                        BorderThickness="0,0,1,0"
                        Padding="0,12,0,12"
                        CornerRadius="0,0,0,12">

                    <Grid Margin="0,8,0,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="16,0,16,12">
                            <TextBlock Text="📊 COLLECTION" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold"/>
                        </StackPanel>

                        <!-- Статистика -->
                        <Border Grid.Row="1" Background="#FF1E1E1E" CornerRadius="10" Margin="16,0,16,14" Padding="14,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="📁" FontSize="14" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding TotalCount}" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="💾" FontSize="14" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding TotalSize}" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="🎬" FontSize="12" Margin="0,0,4,0"/>
                                    <TextBlock Text="{Binding FilmCount}" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                                    <TextBlock Text=" films" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="2,0,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                                    <TextBlock Text="📚" FontSize="12" Margin="0,0,4,0"/>
                                    <TextBlock Text="{Binding BookCount}" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                                    <TextBlock Text=" books" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="2,0,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Категорії -->
                        <StackPanel Grid.Row="2" Margin="12,0,12,0">
                            <TextBlock Text="CATEGORIES" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" Margin="8,0,0,10"/>

                            <!-- All Files -->
                            <Button Style="{StaticResource SelectedCategoryButtonStyle}" 
                                    Command="{Binding FilterCommand}" 
                                    CommandParameter="All"
                                    Margin="0,0,0,2">
                                <Grid>
                                    <TextBlock Text="📂 All Files" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                                    <Border Style="{StaticResource BadgeStyle}" Margin="120,0,8,0">
                                        <TextBlock Text="{Binding TotalCount}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                </Grid>
                            </Button>

                            <!-- Films -->
                            <Button Style="{StaticResource CategoryButtonStyle}" 
                                    Command="{Binding FilterCommand}" 
                                    CommandParameter="Film"
                                    Margin="0,0,0,2">
                                <Grid>
                                    <TextBlock Text="🎬 Films" Foreground="{StaticResource TextSecondary}" FontSize="14" FontWeight="SemiBold"/>
                                    <Border Background="#FF444444" CornerRadius="10" Padding="6,1" Margin="120,0,8,0" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding FilmCount}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                </Grid>
                            </Button>

                            <!-- Books -->
                            <Button Style="{StaticResource CategoryButtonStyle}" 
                                    Command="{Binding FilterCommand}" 
                                    CommandParameter="Book"
                                    Margin="0,0,0,2">
                                <Grid>
                                    <TextBlock Text="📖 Books" Foreground="{StaticResource TextSecondary}" FontSize="14" FontWeight="SemiBold"/>
                                    <Border Background="#FF444444" CornerRadius="10" Padding="6,1" Margin="120,0,8,0" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding BookCount}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                </Grid>
                            </Button>

                            <!-- Music -->
                            <Button Style="{StaticResource CategoryButtonStyle}" 
                                    Command="{Binding FilterCommand}" 
                                    CommandParameter="Music"
                                    Margin="0,0,0,2">
                                <Grid>
                                    <TextBlock Text="🎵 Music" Foreground="{StaticResource TextSecondary}" FontSize="14" FontWeight="SemiBold"/>
                                    <Border Background="#FF444444" CornerRadius="10" Padding="6,1" Margin="120,0,8,0" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding MusicCount}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                </Grid>
                            </Button>

                            <!-- Images -->
                            <Button Style="{StaticResource CategoryButtonStyle}" 
                                    Command="{Binding FilterCommand}" 
                                    CommandParameter="Image"
                                    Margin="0,0,0,2">
                                <Grid>
                                    <TextBlock Text="🖼️ Images" Foreground="{StaticResource TextSecondary}" FontSize="14" FontWeight="SemiBold"/>
                                    <Border Background="#FF444444" CornerRadius="10" Padding="6,1" Margin="120,0,8,0" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding ImageCount}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                </Grid>
                            </Button>

                            <!-- Documents -->
                            <Button Style="{StaticResource CategoryButtonStyle}" 
                                    Command="{Binding FilterCommand}" 
                                    CommandParameter="Document"
                                    Margin="0,0,0,2">
                                <Grid>
                                    <TextBlock Text="📄 Documents" Foreground="{StaticResource TextSecondary}" FontSize="14" FontWeight="SemiBold"/>
                                    <Border Background="#FF444444" CornerRadius="10" Padding="6,1" Margin="120,0,8,0" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding DocumentCount}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                </Grid>
                            </Button>

                            <Border Height="1" Background="{StaticResource BorderColor}" Margin="8,16,8,16"/>

                            <!-- Favorites -->
                            <Button Style="{StaticResource CategoryButtonStyle}" 
                                    Command="{Binding FilterCommand}" 
                                    CommandParameter="Favorite"
                                    Margin="0,0,0,2">
                                <Grid>
                                    <TextBlock Text="⭐ Favorites" Foreground="{StaticResource TextSecondary}" FontSize="14" FontWeight="SemiBold"/>
                                    <Border Background="#FFB8860B" CornerRadius="10" Padding="6,1" Margin="120,0,8,0" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding FavoriteCount}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                </Grid>
                            </Button>
                        </StackPanel>

                        <!-- Налаштування -->
                        <StackPanel Grid.Row="3" Margin="12,0,12,16">
                            <Button Style="{StaticResource CategoryButtonStyle}" Margin="0,0,0,2">
                                <TextBlock Text="⚙️ Settings" Foreground="{StaticResource TextMuted}" FontSize="14" FontWeight="SemiBold"/>
                            </Button>
                            <Button Style="{StaticResource CategoryButtonStyle}" Margin="0,0,0,2">
                                <TextBlock Text="❓ Help" Foreground="{StaticResource TextMuted}" FontSize="14" FontWeight="SemiBold"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ПРАВА ЧАСТИНА -->
                <Grid Grid.Column="1" Background="{StaticResource BackgroundPrimary}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Верхня панель -->
                    <Border Grid.Row="0" 
        Background="{StaticResource BackgroundSecondary}" 
        BorderBrush="{StaticResource BorderColor}" 
        BorderThickness="0,0,0,1"
        Padding="20,12,20,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Рядок 1: Пошук + ComboBox + Кнопки -->
                            <DockPanel Grid.Row="0" LastChildFill="True">
                                <!-- Кнопки праворуч -->
                                <StackPanel DockPanel.Dock="Right" 
                        Orientation="Horizontal" 
                        Margin="12,0,0,0">
                                    <Button Content="📁 Add Folder" 
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding AddFolderCommand}"
                        MinWidth="130"
                        Margin="0,0,8,0"/>
                                    <Button Content="↻" 
                        Style="{StaticResource IconButtonStyle}"
                        Command="{Binding SaveCommand}"
                        ToolTip="Зберегти"
                        Margin="0,0,8,0"/>
                                    <Button Content="🗑️" 
                        Style="{StaticResource IconButtonStyle}"
                        Command="{Binding ClearCommand}"
                        ToolTip="Очистити колекцію"/>
                                </StackPanel>

                                <!-- ComboBox сортування -->
                                <ComboBox DockPanel.Dock="Right"
                      Width="160"
                      Height="38"
                      Background="#FF333333"
                      Foreground="White"
                      BorderThickness="0"
                      Margin="12,0,0,0"
                      SelectedValue="{Binding SortBy}"
                      SelectedValuePath="Tag">
                                    <ComboBoxItem Content="Назва (А-Я)" Tag="Title"/>
                                    <ComboBoxItem Content="Назва (Я-А)" Tag="TitleDesc"/>
                                    <ComboBoxItem Content="Розмір ↓" Tag="Size"/>
                                    <ComboBoxItem Content="Розмір ↑" Tag="SizeAsc"/>
                                    <ComboBoxItem Content="Дата ↓" Tag="Date"/>
                                    <ComboBoxItem Content="Дата ↑" Tag="DateAsc"/>
                                    <ComboBoxItem Content="Рейтинг ↓" Tag="Rating"/>
                                </ComboBox>

                                <!-- Пошук -->
                                <Border Background="#FF333333" 
                    CornerRadius="20" 
                    MaxWidth="480" 
                    HorizontalAlignment="Left"
                    MinWidth="200">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBox Grid.Column="0" 
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource SearchTextBoxStyle}"/>

                                        <TextBlock Grid.Column="1" 
                               Text="⌘" 
                               FontSize="12" 
                               Foreground="{StaticResource TextMuted}" 
                               VerticalAlignment="Center" 
                               Margin="0,0,14,0" 
                               Opacity="0.5"/>
                                    </Grid>
                                </Border>
                            </DockPanel>

                            <!-- Рядок 2: Прогрес-бар (з'являється тільки під час сканування) -->
                            <ProgressBar Grid.Row="1" 
                     Height="4"
                     Value="{Binding ScanProgress}"
                     Maximum="100"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                     Margin="0,10,0,0"
                     Foreground="{StaticResource AccentColor}"
                     Background="#FF333333"
                     BorderThickness="0"/>
                        </Grid>
                    </Border>

                    <!-- КАРТКИ + ПОРОЖНІЙ СТАН -->
                    <Grid Grid.Row="1">
                        <!-- Порожній стан -->
                        <StackPanel HorizontalAlignment="Center" 
                                    VerticalAlignment="Center"
                                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="📁" FontSize="72" HorizontalAlignment="Center" Opacity="0.3"/>
                            <TextBlock Text="Колекція порожня" 
                                       Foreground="{StaticResource TextMuted}" 
                                       FontSize="18" 
                                       HorizontalAlignment="Center"
                                       Margin="0,16,0,8"/>
                            <TextBlock Text="Натисніть 'Add Folder', щоб додати файли" 
                                       Foreground="{StaticResource TextMuted}" 
                                       FontSize="13" 
                                       HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Картки -->
                        <ScrollViewer Margin="12,12,12,6" 
                                      Background="Transparent"
                                      HorizontalScrollBarVisibility="Disabled" 
                                      VerticalScrollBarVisibility="Auto"
                                      Padding="4">

                            <ItemsControl ItemsSource="{Binding FilteredMediaItems}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource MediaCardStyle}"
                                                MouseLeftButtonUp="Card_Click"
                                                Tag="{Binding}">
                                            <Border.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="▶ Відкрити файл" Click="OpenFile_Click"/>
                                                    <MenuItem Header="📂 Показати в папці" Click="ShowInFolder_Click"/>
                                                    <Separator/>
                                                    <MenuItem Header="⭐ Додати до улюблених" Click="ToggleFavorite_Click"/>
                                                    <Separator/>
                                                    <MenuItem Header="🗑️ Видалити з колекції" Click="RemoveFromCollection_Click"/>
                                                </ContextMenu>
                                            </Border.ContextMenu>

                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- Верхня частина (іконка типу) -->
                                                <Border Grid.Row="0" Background="#FF2A2A2A" CornerRadius="12,12,0,0">
                                                    <Grid>
                                                        <TextBlock Text="{Binding TypeIcon}" 
                                                                   FontSize="52" 
                                                                   HorizontalAlignment="Center" 
                                                                   VerticalAlignment="Center" 
                                                                   Opacity="0.4"/>

                                                        <!-- Рейтинг (якщо є) -->
                                                        <Border Background="#FFC05A5A" 
                                                                CornerRadius="4" 
                                                                Padding="6,2" 
                                                                Margin="10,10,10,0" 
                                                                VerticalAlignment="Top" 
                                                                HorizontalAlignment="Right"
                                                                Visibility="{Binding Rating, Converter={StaticResource RatingToVisibilityConverter}}">
                                                            <TextBlock Text="{Binding Rating}" 
                                                                       Foreground="White" 
                                                                       FontSize="11" 
                                                                       FontWeight="Bold"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>

                                                <!-- Нижня частина (назва та розмір) -->
                                                <Border Grid.Row="1" Background="#FF2A2A2A" CornerRadius="0,0,12,12" Padding="10,8">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" 
                                                                   Foreground="White" 
                                                                   FontWeight="Bold" 
                                                                   FontSize="13" 
                                                                   TextTrimming="CharacterEllipsis"
                                                                   MaxWidth="165"/>

                                                        <TextBlock Text="{Binding FormattedSize}" 
                                                                   Foreground="{StaticResource TextMuted}" 
                                                                   FontSize="10" 
                                                                   Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- Нижня панель (пагінація) -->
                    <Border Grid.Row="2" 
        Background="{StaticResource BackgroundSecondary}" 
        BorderBrush="{StaticResource BorderColor}" 
        BorderThickness="0,1,0,0"
        Padding="20,10,20,10"
        CornerRadius="0,0,12,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Ліва частина: статус -->
                            <TextBlock Grid.Column="0" 
                   Text="{Binding StatusText}" 
                   Foreground="{StaticResource TextSecondary}" 
                   FontSize="12"
                   VerticalAlignment="Center"/>

                            <!-- Вибір кількості на сторінку -->
                            <StackPanel Grid.Column="1" 
                    Orientation="Horizontal" 
                    VerticalAlignment="Center"
                    Margin="0,0,16,0">
                                <TextBlock Text="На сторінці:" 
                       Foreground="{StaticResource TextMuted}" 
                       FontSize="12"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"/>

                                <ComboBox Width="70"
                                    Height="30"
                                    Background="#FF333333"
                                    Foreground="White"
                                    BorderThickness="0"
                                    SelectedIndex="0"
                                    SelectionChanged="PageSizeComboBox_SelectionChanged">
                                    <ComboBoxItem Content="30" Tag="30"/>
                                    <ComboBoxItem Content="50" Tag="50"/>
                                    <ComboBoxItem Content="100" Tag="100"/>
                                    <ComboBoxItem Content="200" Tag="200"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- Пагінація -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Попередня -->
                                <Button Content="◀" 
                    Style="{StaticResource IconButtonStyle}" 
                    Width="32" Height="32" 
                    FontSize="12" 
                    Margin="0,0,4,0"
                    Command="{Binding PrevPageCommand}"/>

                                <!-- Інформація про сторінку -->
                                <Border Background="#FF333333" 
                    CornerRadius="6" 
                    Padding="12,4" 
                    Margin="2,0">
                                    <TextBlock Text="{Binding PageInfo}" 
                           Foreground="White" 
                           FontSize="12" 
                           FontWeight="SemiBold"/>
                                </Border>

                                <!-- Наступна -->
                                <Button Content="▶" 
                    Style="{StaticResource IconButtonStyle}" 
                    Width="32" Height="32" 
                    FontSize="12" 
                    Margin="4,0,0,0"
                    Command="{Binding NextPageCommand}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>