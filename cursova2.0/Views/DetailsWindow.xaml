<Window x:Class="MediaVault.Views.DetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:MediaVault.Converters"
        mc:Ignorable="d"
        Title="Деталі файлу" 
        Height="600" 
        Width="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#FF0D0D0D"
        WindowStyle="None"
        AllowsTransparency="True">

    <Window.Resources>
       
        <SolidColorBrush x:Key="BackgroundPrimary" Color="#FF0D0D0D"/>
        <SolidColorBrush x:Key="BackgroundSecondary" Color="#FF1A1A1A"/>
        <SolidColorBrush x:Key="BackgroundCard" Color="#FF2C2C2C"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FFC05A5A"/>
        <SolidColorBrush x:Key="AccentHover" Color="#FFD06A6A"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#FFAAAAAA"/>
        <SolidColorBrush x:Key="TextMuted" Color="#FF666666"/>
        <SolidColorBrush x:Key="BorderColor" Color="#FF333333"/>
        <converters:RatingToVisibilityConverter x:Key="RatingToVisibilityConverter"/>

        <!-- Стиль кнопки -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль другорядної кнопки -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF333333"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF444444"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource BackgroundPrimary}" 
            BorderBrush="{StaticResource BorderColor}" 
            BorderThickness="1"
            CornerRadius="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок вікна -->
            <Border Grid.Row="0" Background="{StaticResource BackgroundSecondary}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" 
                               Text="Деталі файлу" 
                               Foreground="{StaticResource TextPrimary}" 
                               FontSize="14" 
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="16,0"/>

                    <Button Grid.Column="1" 
                            Content="✕" 
                            Width="36" 
                            Height="36"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            FontSize="14"
                            Cursor="Hand"
                            Click="Close_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- Основний контент -->
            <Grid Grid.Row="1" Margin="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Ліва частина: іконка типу -->
                <Border Grid.Column="0" 
                        Background="{StaticResource BackgroundCard}" 
                        CornerRadius="12" 
                        Margin="0,0,20,0">
                    <Grid>
                        <TextBlock Text="{Binding TypeIcon}" 
                                   FontSize="120" 
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center" 
                                   Opacity="0.4"/>

                        <!-- Рейтинг -->
                        <Border Background="{StaticResource AccentColor}" 
                                CornerRadius="6" 
                                Padding="10,4" 
                                Margin="12" 
                                VerticalAlignment="Top" 
                                HorizontalAlignment="Right"
                                Visibility="{Binding Rating, Converter={StaticResource RatingToVisibilityConverter}}">
                            <TextBlock Text="{Binding Rating}" 
                                       Foreground="White" 
                                       FontSize="14" 
                                       FontWeight="Bold"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Права частина: інформація -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Назва -->
                        <TextBlock Text="{Binding Title}" 
                                   Foreground="{StaticResource TextPrimary}" 
                                   FontSize="24" 
                                   FontWeight="Bold"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8"/>

                        <!-- Тип та розмір -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="{Binding TypeIcon}" FontSize="14" Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding Type}" 
                                       Foreground="{StaticResource TextSecondary}" 
                                       FontSize="13"/>
                            <TextBlock Text=" · " Foreground="{StaticResource BorderColor}" FontSize="13"/>
                            <TextBlock Text="{Binding FormattedSize}" 
                                       Foreground="{StaticResource TextSecondary}" 
                                       FontSize="13"/>
                            <TextBlock Text=" · " Foreground="{StaticResource BorderColor}" FontSize="13"/>
                            <TextBlock Text="{Binding FileExtension}" 
                                       Foreground="{StaticResource TextSecondary}" 
                                       FontSize="13"/>
                        </StackPanel>

                        <!-- Шлях -->
                        <TextBlock Text="Шлях до файлу:" 
                                   Foreground="{StaticResource TextMuted}" 
                                   FontSize="11" 
                                   FontWeight="Bold"
                                   Margin="0,0,0,4"/>
                        <Border Background="{StaticResource BackgroundCard}" 
                                CornerRadius="6" 
                                Padding="10,8"
                                Margin="0,0,0,16">
                            <TextBlock Text="{Binding FilePath}" 
                                       Foreground="{StaticResource TextSecondary}" 
                                       FontSize="12"
                                       TextWrapping="Wrap"/>
                        </Border>

                        <!-- Рейтинг -->
                        <TextBlock Text="Рейтинг (1-10):" 
                                   Foreground="{StaticResource TextMuted}" 
                                   FontSize="11" 
                                   FontWeight="Bold"
                                   Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBox Text="{Binding Rating, UpdateSourceTrigger=PropertyChanged}" 
                                     Width="60"
                                     Height="32"
                                     Background="{StaticResource BackgroundCard}"
                                     Foreground="White"
                                     BorderBrush="{StaticResource BorderColor}"
                                     BorderThickness="1"
                                     Padding="8,0"
                                     FontSize="14"
                                     VerticalContentAlignment="Center"/>
                            <TextBlock Text=" / 10" 
                                       Foreground="{StaticResource TextMuted}" 
                                       FontSize="14" 
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0"/>
                        </StackPanel>

                        <!-- Улюблене -->
                        <CheckBox Content="⭐ Додати до улюблених" 
                                  IsChecked="{Binding IsFavorite}" 
                                  Foreground="{StaticResource TextSecondary}"
                                  FontSize="13"
                                  Margin="0,0,0,16"/>

                        <!-- Нотатки -->
                        <TextBlock Text="Нотатки:" 
                                   Foreground="{StaticResource TextMuted}" 
                                   FontSize="11" 
                                   FontWeight="Bold"
                                   Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" 
                                 Height="80"
                                 Background="{StaticResource BackgroundCard}"
                                 Foreground="White"
                                 BorderBrush="{StaticResource BorderColor}"
                                 BorderThickness="1"
                                 Padding="10,8"
                                 FontSize="12"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Нижня панель з кнопками -->
            <Border Grid.Row="2" 
                    Background="{StaticResource BackgroundSecondary}" 
                    BorderBrush="{StaticResource BorderColor}" 
                    BorderThickness="0,1,0,0"
                    Padding="20,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="▶ Відкрити файл" 
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="OpenFile_Click"
                            Margin="0,0,8,0"/>
                    <Button Content="🗑️ Видалити з колекції" 
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="Delete_Click"
                            Margin="0,0,8,0"/>
                    <Button Content="Зберегти" 
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="Save_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>