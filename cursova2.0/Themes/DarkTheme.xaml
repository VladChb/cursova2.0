<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<!-- ===== ФОНИ ===== -->
	<SolidColorBrush x:Key="BackgroundPrimary"   Color="#0F1115"/>
	<SolidColorBrush x:Key="BackgroundSecondary" Color="#161920"/>
	<SolidColorBrush x:Key="BackgroundCard"      Color="#1C2029"/>
	<SolidColorBrush x:Key="CardBorder"          Color="#272C38"/>
	<SolidColorBrush x:Key="CardHover"           Color="#242935"/>
	<SolidColorBrush x:Key="BorderLight"         Color="#353B4A"/>

	<!-- ===== САЙДБАР ===== -->
	<SolidColorBrush x:Key="SidebarBackground" Color="#12141A"/>
	<SolidColorBrush x:Key="SidebarHover"      Color="#1C2029"/>
	<SolidColorBrush x:Key="SidebarSelected"   Color="#242935"/>
	<SolidColorBrush x:Key="SidebarCard"       Color="#1C2029"/>

	<!-- ===== АКЦЕНТ (бурштин) ===== -->
	<SolidColorBrush x:Key="AccentColor" Color="#E5A00D"/>
	<SolidColorBrush x:Key="AccentHover" Color="#F5B41D"/>
	<SolidColorBrush x:Key="AccentDeep"  Color="#B87F08"/>
	<SolidColorBrush x:Key="AccentText"  Color="#141414"/>

	<!-- ===== ТЕКСТ ===== -->
	<!-- ТЕКСТ (у темній темі — світлий) -->
	<SolidColorBrush x:Key="TextPrimaryLight"   Color="#F0F2F5"/>
	<!-- основний текст на темному -->
	<SolidColorBrush x:Key="TextSecondaryLight" Color="#9CA3B5"/>
	<!-- другорядний -->
	<SolidColorBrush x:Key="TextPrimaryDark"    Color="#F0F2F5"/>
	<!-- те саме (для сумісності) -->
	<SolidColorBrush x:Key="TextSecondaryDark"  Color="#9CA3B5"/>
	<!-- те саме -->
	<SolidColorBrush x:Key="TextMutedDark"      Color="#6A7180"/>
	<!-- приглушений -->

	<!-- ===== ІНШЕ ===== -->
	<SolidColorBrush x:Key="BorderColor"      Color="#272C38"/>
	<SolidColorBrush x:Key="InputBackground"  Color="#1C2029"/>
	<SolidColorBrush x:Key="DangerColor"      Color="#E5484D"/>

	<!-- ===== СТАТУСИ БЕЗПЕКИ ===== -->
	<SolidColorBrush x:Key="StatusSafeBackground"       Color="#183A2B"/>
	<SolidColorBrush x:Key="StatusSuspiciousBackground" Color="#40351B"/>
	<SolidColorBrush x:Key="StatusDangerousBackground"  Color="#401F25"/>
	<SolidColorBrush x:Key="StatusSafeForeground"       Color="#42C98A"/>
	<SolidColorBrush x:Key="StatusSuspiciousForeground" Color="#E5A00D"/>
	<SolidColorBrush x:Key="StatusDangerousForeground"  Color="#E5484D"/>

	<!-- ===== БЕЙДЖ УСПІХУ ===== -->
	<SolidColorBrush x:Key="BadgeSuccessBackground" Color="#263B35"/>
	<SolidColorBrush x:Key="BadgeSuccessForeground" Color="#8BD5B0"/>

	<!-- ===== ІНФО-БЛОК ===== -->
	<SolidColorBrush x:Key="InfoBlockBackground" Color="#2B2416"/>

	<SolidColorBrush x:Key="TitleBarBorder" Color="#000000"/>
</ResourceDictionary>