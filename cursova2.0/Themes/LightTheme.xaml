<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Основні кольори -->
    <SolidColorBrush x:Key="BackgroundPrimary" Color="#E8E8ED"/>
    <SolidColorBrush x:Key="BackgroundSecondary" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BackgroundCard" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBorder" Color="#D0D0D8"/>
    <SolidColorBrush x:Key="SidebarBackground" Color="#0A0A0A"/>
    <SolidColorBrush x:Key="SidebarHover" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="SidebarSelected" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="SidebarCard" Color="#181818"/>

    <!-- Акцент -->
    <SolidColorBrush x:Key="AccentColor" Color="#1DB954"/>
    <SolidColorBrush x:Key="AccentHover" Color="#1AA34A"/>

    <!-- Текст -->
    <SolidColorBrush x:Key="TextPrimaryLight" Color="#1D1D1F"/>
    <SolidColorBrush x:Key="TextSecondaryLight" Color="#6E6E73"/>
    <SolidColorBrush x:Key="TextPrimaryDark" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextSecondaryDark" Color="#B3B3B3"/>
    <SolidColorBrush x:Key="TextMutedDark" Color="#6A6A6A"/>
    <SolidColorBrush x:Key="BorderColor" Color="#E5E5EA"/>
    <SolidColorBrush x:Key="InputBackground" Color="#F0F0F5"/>
    <SolidColorBrush x:Key="DangerColor" Color="#FF3B30"/>
</ResourceDictionary>