<Window x:Class="MediaVault.Views.DetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:MediaVault.Converters"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="Деталі файлу" 
        Height="750" 
        Width="1100"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        Closed="Window_Closed">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="52" ResizeBorderThickness="12" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- КОНВЕРТЕРИ -->
        <converters:RatingToVisibilityConverter x:Key="RatingToVisibilityConverter"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <!-- СТИЛЬ PRIMARY КНОПКИ -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="21">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- СТИЛЬ ДРУГОРЯДНОЇ КНОПКИ -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryLight}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="21">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E0E0E5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- СТИЛЬ КНОПОК ВІКНА -->
        <Style x:Key="WindowButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryDark}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2A2A2A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF3B30"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- СТИЛЬ TEXTBOX -->
        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryLight}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="10"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Stretch"
                                          VerticalScrollBarVisibility="Hidden"
                                          HorizontalScrollBarVisibility="Hidden"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="Background" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- СТИЛЬ CHECKBOX -->
        <Style x:Key="ModernCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryLight}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="box" Width="20" Height="20" CornerRadius="6" Background="{DynamicResource InputBackground}" BorderBrush="#D0D0D8" BorderThickness="1" VerticalAlignment="Center">
                                <TextBlock x:Name="check" Text="✓" FontSize="12" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="{DynamicResource AccentColor}"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                                <Setter TargetName="check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- ГОЛОВНИЙ КОНТЕЙНЕР -->
    <Border Background="{DynamicResource BackgroundPrimary}" CornerRadius="16" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Margin="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ЗАГОЛОВОК ВІКНА -->
            <Border Grid.Row="0" Background="{DynamicResource SidebarBackground}" CornerRadius="16,16,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="20,0">
                        <TextBlock Text="📄" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Деталі файлу" Foreground="{DynamicResource TextPrimaryDark}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Grid.Column="1" Content="✕" Style="{StaticResource CloseButtonStyle}" Click="Close_Click" Margin="0,0,12,0" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                </Grid>
            </Border>

            <!-- ОСНОВНИЙ КОНТЕНТ -->
            <Grid Grid.Row="1" Margin="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ЛІВА ЧАСТИНА: ПОСТЕР -->
                <Border Grid.Column="0" 
                        Background="{DynamicResource BackgroundCard}" 
                        CornerRadius="14" 
                        Margin="0,0,24,0"
                        ClipToBounds="True"
                        BorderBrush="{DynamicResource CardBorder}"
                        BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" Opacity="0.12" ShadowDepth="3" BlurRadius="12"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Постер -->
                        <Border Grid.Row="0" Background="{DynamicResource InputBackground}" CornerRadius="14,14,0,0" ClipToBounds="True">
                            <Grid>
                                <!-- 1. ВЕЛИКИЙ ПОСТЕР (для фільмів, книг, музики) -->
                                <Image Source="{Binding PosterUrl}" Stretch="UniformToFill" ClipToBounds="True">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Type}" Value="Film">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Type}" Value="ShortVideo">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Type}" Value="Book">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Type}" Value="Music">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>

                                <!-- 2. МАЛЕНЬКА ІКОНКА ПО ЦЕНТРУ (для програм та зображень) -->
                                <Border Padding="40">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Type}" Value="Program">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Type}" Value="Image">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Image Source="{Binding PosterUrl}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>

                                <!-- Заглушка -->
                                <TextBlock Text="{Binding TypeIcon}" FontSize="120" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.3">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PosterUrl}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding PosterUrl}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- Рейтинг TMDb -->
                                <Border Background="#80000000" CornerRadius="8" Padding="10,6" Margin="12" VerticalAlignment="Top" HorizontalAlignment="Right"
                                        Visibility="{Binding VoteAverage, Converter={StaticResource NullToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⭐" FontSize="14" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding VoteAverage, StringFormat={}{0:F1}}" Foreground="White" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Кнопки під постером -->
                        <StackPanel Grid.Row="1" Margin="12">
                            <Button Content="🖼️ Вибрати обкладинку" Style="{StaticResource SecondaryButtonStyle}" Click="ChooseCover_Click" Margin="0,0,0,8" FontSize="12" Padding="12,10"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="CoverUrlTextBox" Style="{StaticResource ModernTextBoxStyle}" Height="40" Margin="0,0,6,0"/>
                                <Button Grid.Column="1" Content="⬇" Style="{StaticResource SecondaryButtonStyle}" Click="DownloadCover_Click" Width="40" Height="40" Padding="0" FontSize="14"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ПРАВА ЧАСТИНА: ПЕРЕМИКАЧ + КОНТЕНТ -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- ПЕРЕМИКАЧ РЕЖИМІВ -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                        <Button x:Name="InfoTabButton"
                                Content="ℹ️ Інформація"
                                Click="ShowInfo_Click"
                                Background="{DynamicResource AccentColor}"
                                Foreground="White"
                                BorderThickness="0"
                                Padding="16,8"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Cursor="Hand"
                                Margin="0,0,8,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button x:Name="PreviewTabButton"
                                Content="👁️ Перегляд"
                                Click="ShowPreview_Click"
                                Background="{DynamicResource InputBackground}"
                                Foreground="{DynamicResource TextPrimaryLight}"
                                BorderThickness="0"
                                Padding="16,8"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Cursor="Hand"
                                Visibility="{Binding IsPreviewable, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>

                    <!-- ПАНЕЛЬ ІНФОРМАЦІЇ -->
                    <ScrollViewer x:Name="InfoPanel" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Назва -->
                            <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextPrimaryLight}" FontSize="28" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,12"/>

                            <!-- Рік · Жанр · Розмір -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <TextBlock Text="{Binding Year}" Foreground="{DynamicResource TextSecondaryLight}" FontSize="14"/>
                                <TextBlock Text=" · " Foreground="{DynamicResource TextSecondaryLight}" FontSize="14"/>
                                <TextBlock Text="{Binding Genre}" Foreground="{DynamicResource TextSecondaryLight}" FontSize="14" TextTrimming="CharacterEllipsis" MaxWidth="300"/>
                                <TextBlock Text=" · " Foreground="{DynamicResource TextSecondaryLight}" FontSize="14"/>
                                <TextBlock Text="{Binding FormattedSize}" Foreground="{DynamicResource TextSecondaryLight}" FontSize="14"/>
                            </StackPanel>

                            <!-- Опис -->
                            <TextBlock Text="ОПИС" Foreground="{DynamicResource TextSecondaryLight}" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
                            <Border Background="{DynamicResource BackgroundCard}" CornerRadius="12" Padding="16" Margin="0,0,0,20" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
                                <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextPrimaryLight}" FontSize="13" TextWrapping="Wrap" LineHeight="22"/>
                            </Border>

                            <!-- Шлях -->
                            <TextBlock Text="ШЛЯХ ДО ФАЙЛУ" Foreground="{DynamicResource TextSecondaryLight}" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
                            <Border Background="{DynamicResource BackgroundCard}" CornerRadius="12" Padding="16" Margin="0,0,0,20" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
                                <TextBlock Text="{Binding FilePath}" Foreground="{DynamicResource TextSecondaryLight}" FontSize="12" TextWrapping="Wrap"/>
                            </Border>

                            <!-- Рейтинг -->
                            <TextBlock Text="ВАШ РЕЙТИНГ (1-10)" Foreground="{DynamicResource TextSecondaryLight}" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <TextBox Text="{Binding Rating, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Width="80" Height="42"/>
                                <TextBlock Text=" / 10" Foreground="{DynamicResource TextSecondaryLight}" FontSize="14" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>

                            <!-- Улюблене -->
                            <CheckBox Content="⭐ Додати до улюблених" IsChecked="{Binding IsFavorite}" Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,0,20"/>

                            <!-- Нотатки -->
                            <TextBlock Text="НОТАТКИ" Foreground="{DynamicResource TextSecondaryLight}" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
                            <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Height="100" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ПАНЕЛЬ ПЕРЕГЛЯДУ -->
                    <Grid x:Name="PreviewPanel" Grid.Row="1" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Контейнер переглядача -->
                        <Border Grid.Row="0" Background="#000000" CornerRadius="12" ClipToBounds="True">
                            <Grid>
                                <!-- ВІДЕО / МУЗИКА -->
                                <MediaElement x:Name="MediaPlayer" LoadedBehavior="Manual" UnloadedBehavior="Manual" Stretch="Uniform" Visibility="Collapsed"/>

                                <!-- PDF -->
                                <wv2:WebView2 x:Name="PdfViewer" Visibility="Collapsed"/>

                                <!-- ЗОБРАЖЕННЯ -->
                                <Image x:Name="ImageViewer" Stretch="Uniform" Visibility="Collapsed"/>
                            </Grid>
                        </Border>

                        <!-- Кнопки керування -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                            <Button Content="▶ Play" Style="{StaticResource SecondaryButtonStyle}" Click="PlayMedia_Click" Margin="0,0,8,0" Padding="16,8" FontSize="12"/>
                            <Button Content="⏸ Pause" Style="{StaticResource SecondaryButtonStyle}" Click="PauseMedia_Click" Margin="0,0,8,0" Padding="16,8" FontSize="12"/>
                            <Button Content="⏹ Stop" Style="{StaticResource SecondaryButtonStyle}" Click="StopMedia_Click" Margin="0,0,8,0" Padding="16,8" FontSize="12"/>
                            <Button Content="⛶ Повний екран" Style="{StaticResource SecondaryButtonStyle}" Click="Fullscreen_Click" Padding="16,8" FontSize="12"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>

            <!-- НИЖНЯ ПАНЕЛЬ З КНОПКАМИ -->
            <Border Grid.Row="2" Background="{DynamicResource BackgroundSecondary}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0" Padding="24,14" CornerRadius="0,0,16,16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="🌐 Відкрити на TMDb" Style="{StaticResource SecondaryButtonStyle}" Click="OpenTmdb_Click" Margin="0,0,8,0"
                            Visibility="{Binding TmdbUrl, Converter={StaticResource NullToVisibilityConverter}}"/>
                    <Button Content="🎵 Відкрити в iTunes" Style="{StaticResource SecondaryButtonStyle}" Click="OpenTrackUrl_Click" Margin="0,0,8,0"
                            Visibility="{Binding TrackUrl, Converter={StaticResource NullToVisibilityConverter}}"/>
                    <Button Content="▶ Відкрити файл" Style="{StaticResource PrimaryButtonStyle}" Click="OpenFile_Click" Margin="0,0,8,0"/>
                    <Button Content="🗑️ Видалити" Style="{StaticResource SecondaryButtonStyle}" Click="Delete_Click" Margin="0,0,8,0"/>
                    <Button Content="Зберегти" Style="{StaticResource SecondaryButtonStyle}" Click="Save_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>