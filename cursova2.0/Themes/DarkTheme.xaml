<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Основні кольори -->
    <SolidColorBrush x:Key="BackgroundPrimary" Color="#0D0D0D"/>
    <SolidColorBrush x:Key="BackgroundSecondary" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="BackgroundCard" Color="#2C2C2C"/>
    <SolidColorBrush x:Key="CardBorder" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="SidebarBackground" Color="#000000"/>
    <SolidColorBrush x:Key="SidebarHover" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="SidebarSelected" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="SidebarCard" Color="#1A1A1A"/>

    <!-- Акцент -->
    <SolidColorBrush x:Key="AccentColor" Color="#1DB954"/>
    <SolidColorBrush x:Key="AccentHover" Color="#1AA34A"/>

    <!-- Текст -->
    <SolidColorBrush x:Key="TextPrimaryLight" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextSecondaryLight" Color="#B3B3B3"/>
    <SolidColorBrush x:Key="TextPrimaryDark" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextSecondaryDark" Color="#B3B3B3"/>
    <SolidColorBrush x:Key="TextMutedDark" Color="#6A6A6A"/>
    <SolidColorBrush x:Key="BorderColor" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="InputBackground" Color="#2C2C2C"/>
    <SolidColorBrush x:Key="DangerColor" Color="#FF3B30"/>
</ResourceDictionary>