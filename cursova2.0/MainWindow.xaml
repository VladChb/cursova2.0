<Window x:Class="MediaVault.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MediaVault"
        xmlns:converters="clr-namespace:MediaVault.Converters"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="MediaVault" 
        WindowState="Normal"
        ResizeMode="CanResize"
        MinHeight="650" 
        MinWidth="1000"
        Height="800"
        Width="1400"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome 
            CaptionHeight="52"
            ResizeBorderThickness="12"
            GlassFrameThickness="0"
            CornerRadius="0"
            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Key="F" Modifiers="Control" Command="{Binding FocusSearchCommand}"/>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding AddFolderCommand}"/>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}"/>
        <KeyBinding Key="E" Modifiers="Control" Command="{Binding ExportReportCommand}"/>
        <KeyBinding Key="D" Modifiers="Control" Command="{Binding FindDuplicatesCommand}"/>
        <KeyBinding Key="R" Modifiers="Control" Command="{Binding RefreshMetadataCommand}"/>
        <KeyBinding Key="F1" Command="{Binding OpenHelpCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <!-- КОНВЕРТЕРИ -->
        <converters:RatingToVisibilityConverter x:Key="RatingToVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>

        <!-- ============================================================ -->
        <!-- СТИЛЬ СКРОЛБАРУ -->
        <!-- ============================================================ -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Background="#C7C7CC" Height="40">
                                        <Thumb.Resources>
                                            <Style TargetType="Thumb">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Border Background="{TemplateBinding Background}" 
                                                                    CornerRadius="3" 
                                                                    Margin="2"/>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Thumb.Resources>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================================ -->
        <!-- СТИЛЬ КАРТКИ -->
        <!-- ============================================================ -->
        <Style x:Key="MediaCardStyle" TargetType="Border">
            <Setter Property="Width" Value="200"/>
            <Setter Property="Height" Value="320"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Background" Value="{DynamicResource BackgroundCard}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" Opacity="0.12" ShadowDepth="3" BlurRadius="12"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#000000" Opacity="0.25" ShadowDepth="8" BlurRadius="20"/>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="1.03" ScaleY="1.03"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ============================================================ -->
        <!-- СТИЛЬ PRIMARY КНОПКИ -->
        <!-- ============================================================ -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="MinWidth" Value="130"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="21">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ============================================================ -->
        <!-- СТИЛЬ ІКОНКОВОЇ КНОПКИ -->
        <!-- ============================================================ -->
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryLight}"/>
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="MinWidth" Value="42"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="21">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E0E0E5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ============================================================ -->
        <!-- СТИЛЬ КНОПОК ПАГІНАЦІЇ -->
        <!-- ============================================================ -->
        <Style x:Key="PaginationButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryLight}"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="36"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ============================================================ -->
        <!-- СТИЛЬ КНОПОК ВІКНА -->
        <!-- ============================================================ -->
        <Style x:Key="WindowButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryDark}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2A2A2A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF3B30"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ============================================================ -->
        <!-- СТИЛЬ КАТЕГОРІЙ -->
        <!-- ============================================================ -->
        <Style x:Key="CategoryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8" 
                                Margin="0">
                            <ContentPresenter HorizontalAlignment="Left" 
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SidebarHover}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SidebarSelected}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SelectedCategoryButtonStyle" TargetType="Button" BasedOn="{StaticResource CategoryButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource SidebarSelected}"/>
        </Style>

        <!-- ============================================================ -->
        <!-- СТИЛЬ БЕЙДЖА -->
        <!-- ============================================================ -->
        <Style x:Key="BadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="MinWidth" Value="28"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>

        <!-- ============================================================ -->
        <!-- СТИЛЬ COMBOBOX -->
        <!-- ============================================================ -->
        <Style x:Key="ModernComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryLight}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="Transparent"
                                          BorderThickness="0">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <ContentPresenter Grid.Column="0"
                                                                  Margin="14,0"
                                                                  VerticalAlignment="Center"
                                                                  HorizontalAlignment="Left"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"/>

                                                <TextBlock Grid.Column="1" 
                                                           Text="▾" 
                                                           FontSize="12"
                                                           Margin="0,0,14,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextSecondaryLight}"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup x:Name="PART_Popup" 
                                   AllowsTransparency="True" 
                                   Placement="Bottom" 
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Slide">
                                <Border Background="{DynamicResource BackgroundSecondary}" 
                                        CornerRadius="10" 
                                        Margin="0,4,0,0"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="300">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" Opacity="0.15" ShadowDepth="4" BlurRadius="12"/>
                                    </Border.Effect>
                                    <ScrollViewer>
                                        <StackPanel>
                                            <ItemsPresenter/>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleButton" Property="Background" Value="#E5E5EA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- СТИЛЬ ЕЛЕМЕНТІВ COMBOBOX -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryLight}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border Background="Transparent" 
                                x:Name="itemBorder"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource InputBackground}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#E8F5E9"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================================ -->
        <!-- СТИЛЬ ПОЛЯ ПОШУКУ -->
        <!-- ============================================================ -->
        <Style x:Key="SearchTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryLight}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" 
                                      VerticalAlignment="Center"
                                      Margin="0"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- ГОЛОВНИЙ КОНТЕЙНЕР -->
    <Border Background="{DynamicResource BackgroundPrimary}" 
            CornerRadius="16"
            BorderBrush="{DynamicResource BorderColor}"
            BorderThickness="1"
            Margin="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ЗАГОЛОВОК ВІКНА -->
            <Border Grid.Row="0" 
                    Background="{DynamicResource SidebarBackground}" 
                    CornerRadius="16,16,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="20,0">
                        <Border Width="32" Height="32" Background="{DynamicResource AccentColor}" CornerRadius="8" Margin="0,0,12,0">
                            <TextBlock Text="⚡" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="MediaVault" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryDark}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,12,0">
                        <Button Content="─" 
                                Style="{StaticResource WindowButtonStyle}" 
                                Click="MinimizeWindow_Click"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button Content="☐" 
                                Style="{StaticResource WindowButtonStyle}" 
                                Click="MaximizeWindow_Click"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button Content="✕" 
                                Style="{StaticResource CloseButtonStyle}" 
                                Click="CloseWindow_Click"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ОСНОВНА ЧАСТИНА -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ЛІВА ПАНЕЛЬ -->
                <Border Grid.Column="0" 
                        Background="{DynamicResource SidebarBackground}"
                        CornerRadius="0,0,0,16">

                    <Grid Margin="0,16,0,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Статистика -->
                        <Border Grid.Row="0" 
                                Background="{DynamicResource SidebarCard}" 
                                CornerRadius="12" 
                                Margin="16,0,16,20" 
                                Padding="16,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="📁" FontSize="16" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding TotalCount}" Foreground="White" FontSize="15" FontWeight="SemiBold"/>
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="💾" FontSize="16" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding TotalSize}" Foreground="White" FontSize="15" FontWeight="SemiBold"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="🎬" FontSize="13" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding FilmCount}" Foreground="{DynamicResource TextSecondaryDark}" FontSize="13"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                                    <TextBlock Text="📚" FontSize="13" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding BookCount}" Foreground="{DynamicResource TextSecondaryDark}" FontSize="13"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- КАТЕГОРІЇ -->
                        <StackPanel Grid.Row="2" Margin="12,0,12,0" 
                                    Visibility="{Binding IsCategoriesMode, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="КАТЕГОРІЇ" Foreground="{DynamicResource TextMutedDark}" FontSize="11" FontWeight="Bold" Margin="8,0,0,10"/>

                            <!-- All Files -->
                            <Button Style="{StaticResource SelectedCategoryButtonStyle}" 
                                    Command="{Binding FilterCommand}" 
                                    CommandParameter="All"
                                    Margin="0,0,0,2">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="🔄 Оновити метадані для всіх файлів" 
                                                  Command="{Binding PlacementTarget.DataContext.RefreshMetadataForCategoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="All"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="📂 Усі файли" Foreground="White" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" Style="{StaticResource BadgeStyle}">
                                        <TextBlock Text="{Binding TotalCount}" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Button>

                            <!-- Films -->
                            <Button Style="{StaticResource CategoryButtonStyle}" 
                                    Command="{Binding FilterCommand}" 
                                    CommandParameter="Film"
                                    Margin="0,0,0,2">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="🔄 Оновити метадані для цієї категорії" 
                                                  Command="{Binding PlacementTarget.DataContext.RefreshMetadataForCategoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="Film"/>
                                        <Separator/>
                                        <MenuItem Header="🗑️ Видалити цю категорію з колекції" 
                                                  Command="{Binding PlacementTarget.DataContext.ClearCategoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="Film"
                                                  Foreground="Red"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="🎬 Фільми (30+ хв)" Foreground="{DynamicResource TextSecondaryDark}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" Style="{StaticResource BadgeStyle}">
                                        <TextBlock Text="{Binding FilmCount}" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Button>

                            <!-- ShortVideo -->
                            <Button Style="{StaticResource CategoryButtonStyle}" 
                                    Command="{Binding FilterCommand}" 
                                    CommandParameter="ShortVideo"
                                    Margin="0,0,0,2">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="🔄 Оновити метадані для цієї категорії" 
                                                  Command="{Binding PlacementTarget.DataContext.RefreshMetadataForCategoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="ShortVideo"/>
                                        <Separator/>
                                        <MenuItem Header="🗑️ Видалити цю категорію з колекції" 
                                                  Command="{Binding PlacementTarget.DataContext.ClearCategoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="ShortVideo"
                                                  Foreground="Red"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="📱 Короткі відео" Foreground="{DynamicResource TextSecondaryDark}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" Style="{StaticResource BadgeStyle}">
                                        <TextBlock Text="{Binding ShortVideoCount}" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Button>

                            <!-- Books -->
                            <Button Style="{StaticResource CategoryButtonStyle}" 
                                    Command="{Binding FilterCommand}" 
                                    CommandParameter="Book"
                                    Margin="0,0,0,2">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="🔄 Оновити метадані для цієї категорії" 
                                                  Command="{Binding PlacementTarget.DataContext.RefreshMetadataForCategoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="Book"/>
                                        <Separator/>
                                        <MenuItem Header="🗑️ Видалити цю категорію з колекції" 
                                                  Command="{Binding PlacementTarget.DataContext.ClearCategoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="Book"
                                                  Foreground="Red"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="📖 Книги" Foreground="{DynamicResource TextSecondaryDark}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" Style="{StaticResource BadgeStyle}">
                                        <TextBlock Text="{Binding BookCount}" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Button>

                            <!-- Music -->
                            <Button Style="{StaticResource CategoryButtonStyle}" 
                                    Command="{Binding FilterCommand}" 
                                    CommandParameter="Music"
                                    Margin="0,0,0,2">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="🔄 Оновити метадані для цієї категорії" 
                                                  Command="{Binding PlacementTarget.DataContext.RefreshMetadataForCategoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="Music"/>
                                        <Separator/>
                                        <MenuItem Header="🗑️ Видалити цю категорію з колекції" 
                                                  Command="{Binding PlacementTarget.DataContext.ClearCategoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="Music"
                                                  Foreground="Red"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="🎵 Музика" Foreground="{DynamicResource TextSecondaryDark}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" Style="{StaticResource BadgeStyle}">
                                        <TextBlock Text="{Binding MusicCount}" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Button>

                            <!-- Images -->
                            <Button Style="{StaticResource CategoryButtonStyle}" 
                                    Command="{Binding FilterCommand}" 
                                    CommandParameter="Image"
                                    Margin="0,0,0,2">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="🔄 Оновити метадані для цієї категорії" 
                                                  Command="{Binding PlacementTarget.DataContext.RefreshMetadataForCategoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="Image"/>
                                        <Separator/>
                                        <MenuItem Header="🗑️ Видалити цю категорію з колекції" 
                                                  Command="{Binding PlacementTarget.DataContext.ClearCategoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="Image"
                                                  Foreground="Red"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="🖼️ Зображення" Foreground="{DynamicResource TextSecondaryDark}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" Style="{StaticResource BadgeStyle}">
                                        <TextBlock Text="{Binding ImageCount}" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Button>

                            <!-- Documents -->
                            <Button Style="{StaticResource CategoryButtonStyle}" 
                                    Command="{Binding FilterCommand}" 
                                    CommandParameter="Document"
                                    Margin="0,0,0,2">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="🔄 Оновити метадані для цієї категорії" 
                                                  Command="{Binding PlacementTarget.DataContext.RefreshMetadataForCategoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="Document"/>
                                        <Separator/>
                                        <MenuItem Header="🗑️ Видалити цю категорію з колекції" 
                                                  Command="{Binding PlacementTarget.DataContext.ClearCategoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="Document"
                                                  Foreground="Red"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="📄 Документи" Foreground="{DynamicResource TextSecondaryDark}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" Style="{StaticResource BadgeStyle}">
                                        <TextBlock Text="{Binding DocumentCount}" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Button>

                            <!-- Programs -->
                            <Button Style="{StaticResource CategoryButtonStyle}" 
                                    Command="{Binding FilterCommand}" 
                                    CommandParameter="Program"
                                    Margin="0,0,0,2">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="🔄 Оновити метадані для цієї категорії" 
                                                  Command="{Binding PlacementTarget.DataContext.RefreshMetadataForCategoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="Program"/>
                                        <Separator/>
                                        <MenuItem Header="🗑️ Видалити цю категорію з колекції" 
                                                  Command="{Binding PlacementTarget.DataContext.ClearCategoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="Program"
                                                  Foreground="Red"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="💻 Програми" Foreground="{DynamicResource TextSecondaryDark}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" Style="{StaticResource BadgeStyle}">
                                        <TextBlock Text="{Binding ProgramCount}" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Button>

                            <Border Height="1" Background="#2A2A2A" Margin="8,16,8,16"/>

                            <!-- Favorites -->
                            <Button Style="{StaticResource CategoryButtonStyle}" 
                                    Command="{Binding FilterCommand}" 
                                    CommandParameter="Favorite"
                                    Margin="0,0,0,2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="⭐ Улюблені" Foreground="{DynamicResource TextSecondaryDark}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" Style="{StaticResource BadgeStyle}">
                                        <TextBlock Text="{Binding FavoriteCount}" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Button>


                            <TextBlock Text="ДЖЕРЕЛА" Foreground="{DynamicResource TextMutedDark}" FontSize="11" FontWeight="Bold" Margin="8,0,0,10"/>

                            <Button Style="{StaticResource CategoryButtonStyle}" Command="{Binding ClearFolderFilterCommand}" Margin="0,0,0,2">
                                <TextBlock Text="🌐 Усі джерела" Foreground="{DynamicResource TextSecondaryDark}" FontSize="13" FontWeight="SemiBold"/>
                            </Button>

                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="300" Margin="0,4,0,0">
                                <TreeView ItemsSource="{Binding RootFolders}" 
              Background="Transparent" 
              BorderThickness="0"
              SelectedItemChanged="TreeView_SelectedItemChanged">
                                    <TreeView.ItemContainerStyle>
                                        <Style TargetType="TreeViewItem">
                                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryDark}"/>
                                            <Setter Property="FontSize" Value="13"/>
                                            <Setter Property="Padding" Value="2"/>
                                        </Style>
                                    </TreeView.ItemContainerStyle>

                                    <TreeView.ItemTemplate>
                                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="📂" FontSize="12" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding FileCount, StringFormat=' ({0})'}" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedDark}" FontSize="11" Margin="4,0,0,0"/>
                                            </StackPanel>
                                        </HierarchicalDataTemplate>
                                    </TreeView.ItemTemplate>
                                </TreeView>
                            </ScrollViewer>
                        </StackPanel>

                        <!-- ІНСТРУМЕНТИ -->
                        <StackPanel Grid.Row="2" Margin="12,0,12,0" 
                                    Visibility="{Binding IsToolsMode, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="ІНСТРУМЕНТИ" Foreground="{DynamicResource TextMutedDark}" FontSize="11" FontWeight="Bold" Margin="8,0,0,10"/>

                            <Button Style="{StaticResource CategoryButtonStyle}" Click="OpenDashboard_Click" Margin="0,0,0,2">
                                <TextBlock Text="📊 Статистика" Foreground="{DynamicResource TextSecondaryDark}" FontSize="14" FontWeight="SemiBold"/>
                            </Button>

                            <Button Style="{StaticResource CategoryButtonStyle}" Command="{Binding FindDuplicatesCommand}" Margin="0,0,0,2">
                                <TextBlock Text="🔍 Пошук дублікатів" Foreground="{DynamicResource TextSecondaryDark}" FontSize="14" FontWeight="SemiBold"/>
                            </Button>

                            <Button Style="{StaticResource CategoryButtonStyle}" Command="{Binding ExportReportCommand}" Margin="0,0,0,2">
                                <TextBlock Text="🖨 Звіт для друку" Foreground="{DynamicResource TextSecondaryDark}" FontSize="14" FontWeight="SemiBold"/>
                            </Button>

                            <Button Style="{StaticResource CategoryButtonStyle}" Command="{Binding RefreshMetadataCommand}" Margin="0,0,0,2">
                                <TextBlock Text="🔄 Оновити всі метадані" Foreground="{DynamicResource TextSecondaryDark}" FontSize="14" FontWeight="SemiBold"/>
                            </Button>

                            <Button Style="{StaticResource CategoryButtonStyle}" Command="{Binding RefreshMetadataForFolderCommand}" Margin="0,0,0,2">
                                <TextBlock Text="🔄 Оновити метадані (папка)" Foreground="{DynamicResource TextSecondaryDark}" FontSize="14" FontWeight="SemiBold"/>
                            </Button>
                            <Button Style="{StaticResource CategoryButtonStyle}" 
        Command="{Binding RemoveFolderCommand}"
        Margin="0,0,0,2">
                                <TextBlock Text="📂 Видалити папку з колекції" 
                Foreground="{DynamicResource TextSecondaryDark}" 
                FontSize="14" 
                FontWeight="SemiBold"/>
                            </Button>

                            <Button Style="{StaticResource CategoryButtonStyle}" Command="{Binding VerifyCollectionCommand}" Margin="0,0,0,2">
                                <TextBlock Text="✓ Перевірити колекцію" Foreground="{DynamicResource TextSecondaryDark}" FontSize="14" FontWeight="SemiBold"/>
                            </Button>

                            <Button Style="{StaticResource CategoryButtonStyle}" Click="OpenSecurityScanner_Click" Margin="0,0,0,2">
                                <TextBlock Text="🛡️ Сканер безпеки" Foreground="{DynamicResource TextSecondaryDark}" FontSize="14" FontWeight="SemiBold"/>
                            </Button>

                            <Border Height="1" Background="#2A2A2A" Margin="8,16,8,16"/>

                            <Button Style="{StaticResource CategoryButtonStyle}" Click="OpenSettings_Click" Margin="0,0,0,2">
                                <TextBlock Text="⚙️ Налаштування" Foreground="{DynamicResource TextSecondaryDark}" FontSize="14" FontWeight="SemiBold"/>
                            </Button>

                            <Button Style="{StaticResource CategoryButtonStyle}" Click="OpenHelp_Click" Margin="0,0,0,2">
                                <TextBlock Text="❓ Довідка" Foreground="{DynamicResource TextSecondaryDark}" FontSize="14" FontWeight="SemiBold"/>
                            </Button>
                        </StackPanel>

                        <!-- НИЗ: Кнопка перемикання -->
                        <StackPanel Grid.Row="3" Margin="12,0,12,20">
                            <Border Height="1" Background="#2A2A2A" Margin="8,0,8,12"/>
                            <Button Style="{StaticResource CategoryButtonStyle}" Command="{Binding ToggleToolsCommand}" Margin="0,0,0,2">
                                <TextBlock Text="{Binding ToolsButtonText}" 
                                           Foreground="{DynamicResource TextSecondaryDark}" 
                                           FontSize="14" 
                                           FontWeight="SemiBold"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ПРАВА ЧАСТИНА -->
                <Grid Grid.Column="1" Background="{DynamicResource BackgroundPrimary}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Верхня панель -->
                    <Border Grid.Row="0" 
                            Background="{DynamicResource BackgroundSecondary}" 
                            BorderBrush="{DynamicResource BorderColor}" 
                            BorderThickness="0,0,0,1"
                            Padding="24,16,24,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" LastChildFill="True">
                                <StackPanel DockPanel.Dock="Right" 
                                            Orientation="Horizontal" 
                                            Margin="16,0,0,0">
                                    <Button Content="📁 Додати папку" 
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Command="{Binding AddFolderCommand}"
                                            Margin="0,0,10,0"/>
                                    <Button Content="↻" 
                                            Style="{StaticResource IconButtonStyle}"
                                            Command="{Binding SaveCommand}"
                                            ToolTip="Зберегти"
                                            Margin="0,0,10,0"/>
                                    <Button Content="🗑️" 
                                            Style="{StaticResource IconButtonStyle}"
                                            Command="{Binding ClearCommand}"
                                            ToolTip="Очистити колекцію"/>
                                </StackPanel>

                                <ComboBox DockPanel.Dock="Right"
                                          Style="{StaticResource ModernComboBoxStyle}"
                                          Width="170"
                                          Margin="16,0,0,0"
                                          SelectedValue="{Binding SortBy}"
                                          SelectedValuePath="Tag">
                                    <ComboBoxItem Content="Назва (А-Я)" Tag="Title"/>
                                    <ComboBoxItem Content="Назва (Я-А)" Tag="TitleDesc"/>
                                    <ComboBoxItem Content="Розмір ↓" Tag="Size"/>
                                    <ComboBoxItem Content="Розмір ↑" Tag="SizeAsc"/>
                                    <ComboBoxItem Content="Дата ↓" Tag="Date"/>
                                    <ComboBoxItem Content="Дата ↑" Tag="DateAsc"/>
                                    <ComboBoxItem Content="Рейтинг ↓" Tag="Rating"/>
                                </ComboBox>

                                <Border Background="{DynamicResource InputBackground}" 
                                        CornerRadius="21" 
                                        MaxWidth="480" 
                                        HorizontalAlignment="Left"
                                        MinWidth="200"
                                        Height="42">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBox x:Name="SearchBox"
                                                   Grid.Column="0" 
                                                   Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                                   Style="{StaticResource SearchTextBoxStyle}"
                                                   ToolTip="Пошук за назвою, автором, жанром або SHA-256 хешем"
                                                   Margin="18,0,10,0"/>

                                        <TextBlock Grid.Column="1" 
                                                   Text="🔍" 
                                                   FontSize="14" 
                                                   Foreground="{DynamicResource TextSecondaryLight}" 
                                                   VerticalAlignment="Center" 
                                                   Margin="0,0,16,0"/>
                                    </Grid>
                                </Border>
                            </DockPanel>

                            <Grid Grid.Row="1" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <ProgressBar Grid.Column="0" 
                                             Height="6"
                                             Value="{Binding ScanProgress}"
                                             Maximum="100"
                                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                                             Foreground="{DynamicResource AccentColor}"
                                             Background="{DynamicResource InputBackground}"
                                             BorderThickness="0"
                                             Margin="0,0,16,0"/>

                                <TextBlock Grid.Column="1" 
                                           Text="{Binding ProgressInfo}" 
                                           Foreground="{DynamicResource TextSecondaryLight}" 
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- КАРТКИ + ПОРОЖНІЙ СТАН -->
                    <Grid Grid.Row="1">
                        <StackPanel HorizontalAlignment="Center" 
                                    VerticalAlignment="Center"
                                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="📁" FontSize="80" HorizontalAlignment="Center" Opacity="0.15"/>
                            <TextBlock Text="Колекція порожня" 
                                       Foreground="{DynamicResource TextPrimaryLight}" 
                                       FontSize="22" 
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Margin="0,20,0,8"/>
                            <TextBlock Text="Натисніть 'Додати папку', щоб почати" 
                                       Foreground="{DynamicResource TextSecondaryLight}" 
                                       FontSize="14" 
                                       HorizontalAlignment="Center"/>
                        </StackPanel>

                        <ScrollViewer Margin="16,16,16,8" 
                                      Background="Transparent"
                                      HorizontalScrollBarVisibility="Disabled" 
                                      VerticalScrollBarVisibility="Auto"
                                      Padding="4"
                                      VirtualizingStackPanel.IsVirtualizing="True"
                                      VirtualizingStackPanel.VirtualizationMode="Recycling">

                            <ItemsControl ItemsSource="{Binding FilteredMediaItems}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource MediaCardStyle}"
                                                MouseLeftButtonUp="Card_Click"
                                                Tag="{Binding}">
                                            <Border.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="▶ Відкрити файл" Click="OpenFile_Click"/>
                                                    <MenuItem Header="📂 Показати в папці" Click="ShowInFolder_Click"/>
                                                    <Separator/>
                                                    <MenuItem Header="✏️ Перейменувати" Click="RenameFile_Click"/>
                                                    <MenuItem Header="📋 Копіювати шлях" Click="CopyPath_Click"/>
                                                    <MenuItem Header="📋 Копіювати назву" Click="CopyTitle_Click"/>
                                                    <Separator/>
                                                    <MenuItem Header="🌐 Відкрити на TMDb" Click="OpenTmdbFromCard_Click"/>
                                                    <MenuItem Header="🎵 Відкрити в iTunes" Click="OpenTrackUrlFromCard_Click"/>
                                                    <Separator/>
                                                    <MenuItem Header="🖼️ Вибрати обкладинку" Click="ChooseCoverFromCard_Click"/>
                                                    <Separator/>
                                                    <MenuItem Header="⭐ Додати до улюблених" Click="ToggleFavorite_Click"/>
                                                    <Separator/>
                                                    <MenuItem Header="🗑️ Видалити з колекції" Click="RemoveFromCollection_Click"/>
                                                </ContextMenu>
                                            </Border.ContextMenu>

                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <Border Grid.Row="0" 
                                                        Background="{DynamicResource InputBackground}" 
                                                        CornerRadius="14,14,0,0"
                                                        ClipToBounds="True">
                                                    <Grid>
                                                        <Image Source="{Binding PosterUrl}" 
                                                               Stretch="UniformToFill"
                                                               ClipToBounds="True">
                                                            <Image.Style>
                                                                <Style TargetType="Image">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Type}" Value="Film">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Type}" Value="ShortVideo">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Type}" Value="Book">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Type}" Value="Music">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Image.Style>
                                                        </Image>

                                                        <Border Padding="30">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Type}" Value="Program">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Type}" Value="Image">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <Image Source="{Binding PosterUrl}" 
                                                                   Stretch="Uniform"
                                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                                        </Border>

                                                        <TextBlock Text="{Binding TypeIcon}" 
                                                                   FontSize="56" 
                                                                   HorizontalAlignment="Center" 
                                                                   VerticalAlignment="Center" 
                                                                   Opacity="0.3">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding PosterUrl}" Value="{x:Null}">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding PosterUrl}" Value="">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>

                                                        <Border Background="#80000000" 
                                                                CornerRadius="8" 
                                                                Padding="6,4" 
                                                                Margin="10,10,0,0" 
                                                                VerticalAlignment="Top" 
                                                                HorizontalAlignment="Left">
                                                            <TextBlock Text="{Binding TypeIcon}" FontSize="14"/>
                                                        </Border>

                                                        <Border Background="#80000000" 
                                                                CornerRadius="8" 
                                                                Padding="8,4" 
                                                                Margin="0,10,10,0" 
                                                                VerticalAlignment="Top" 
                                                                HorizontalAlignment="Right"
                                                                Visibility="{Binding VoteAverage, Converter={StaticResource RatingToVisibilityConverter}}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="⭐" FontSize="11" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding VoteAverage, StringFormat={}{0:F1}}" 
                                                                           Foreground="White" 
                                                                           FontSize="11" 
                                                                           FontWeight="Bold"
                                                                           VerticalAlignment="Center"
                                                                           Margin="3,0,0,0"/>
                                                            </StackPanel>
                                                        </Border>

                                                        <Border Background="{DynamicResource AccentColor}" 
                                                                CornerRadius="8" 
                                                                Padding="8,4" 
                                                                Margin="0,0,10,10" 
                                                                VerticalAlignment="Bottom" 
                                                                HorizontalAlignment="Right"
                                                                Visibility="{Binding Rating, Converter={StaticResource RatingToVisibilityConverter}}">
                                                            <TextBlock Text="{Binding Rating}" 
                                                                       Foreground="White" 
                                                                       FontSize="11" 
                                                                       FontWeight="Bold"/>
                                                        </Border>

                                                        <Border Background="#80FF3B30" 
                                                                CornerRadius="8" 
                                                                Padding="6,4" 
                                                                Margin="10,0,0,10" 
                                                                VerticalAlignment="Bottom" 
                                                                HorizontalAlignment="Left"
                                                                Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <TextBlock Text="❤️" FontSize="12"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>

                                                <Border Grid.Row="1" 
                                                        Background="{DynamicResource BackgroundCard}" 
                                                        CornerRadius="0,0,14,14" 
                                                        Padding="12,10">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" 
                                                                   Foreground="{DynamicResource TextPrimaryLight}" 
                                                                   FontWeight="SemiBold" 
                                                                   FontSize="13" 
                                                                   TextTrimming="CharacterEllipsis"
                                                                   MaxWidth="180"/>

                                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                            <TextBlock Text="{Binding Year}" 
                                                                       Foreground="{DynamicResource TextSecondaryLight}" 
                                                                       FontSize="11"/>
                                                            <TextBlock Text=" · " 
                                                                       Foreground="{DynamicResource TextSecondaryLight}" 
                                                                       FontSize="11"
                                                                       Visibility="{Binding Year, Converter={StaticResource NullToVisibilityConverter}}"/>
                                                            <TextBlock Text="{Binding Genre}" 
                                                                       Foreground="{DynamicResource TextSecondaryLight}" 
                                                                       FontSize="11"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       MaxWidth="120"/>
                                                        </StackPanel>

                                                        <TextBlock Text="{Binding FormattedSize}" 
                                                                   Foreground="{DynamicResource TextSecondaryLight}" 
                                                                   FontSize="10" 
                                                                   Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- Нижня панель (пагінація) -->
                    <Border Grid.Row="2" 
                            Background="{DynamicResource BackgroundSecondary}" 
                            BorderBrush="{DynamicResource BorderColor}" 
                            BorderThickness="0,1,0,0"
                            Padding="24,12,24,12"
                            CornerRadius="0,0,16,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" 
                                       Text="{Binding StatusText}" 
                                       Foreground="{DynamicResource TextSecondaryLight}" 
                                       FontSize="12"
                                       VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="1" 
                                        Orientation="Horizontal" 
                                        VerticalAlignment="Center"
                                        Margin="0,0,20,0">
                                <TextBlock Text="На сторінці:" 
                                           Foreground="{DynamicResource TextSecondaryLight}" 
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"/>

                                <ComboBox Style="{StaticResource ModernComboBoxStyle}"
                                          Width="80"
                                          Height="34"
                                          FontSize="12"
                                          SelectedIndex="0"
                                          SelectionChanged="PageSizeComboBox_SelectionChanged">
                                    <ComboBoxItem Content="30" Tag="30"/>
                                    <ComboBoxItem Content="50" Tag="50"/>
                                    <ComboBoxItem Content="100" Tag="100"/>
                                    <ComboBoxItem Content="200" Tag="200"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="◀" 
                                        Style="{StaticResource PaginationButtonStyle}" 
                                        Margin="0,0,8,0"
                                        Command="{Binding PrevPageCommand}"/>

                                <Border Background="{DynamicResource InputBackground}" 
                                        CornerRadius="10" 
                                        Padding="16,8" 
                                        Margin="0,0,8,0"
                                        MinWidth="120">
                                    <TextBlock Text="{Binding PageInfo}" 
                                               Foreground="{DynamicResource TextPrimaryLight}" 
                                               FontSize="12" 
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <Button Content="▶" 
                                        Style="{StaticResource PaginationButtonStyle}"
                                        Command="{Binding NextPageCommand}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>