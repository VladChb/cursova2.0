<Window x:Class="MediaVault.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Довідка" 
        Height="650" 
        Width="750"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="52" ResizeBorderThickness="12" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>

        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF3B30"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource BackgroundPrimary}" CornerRadius="16" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Margin="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ЗАГОЛОВОК -->
            <Border Grid.Row="0" Background="{DynamicResource SidebarBackground}" CornerRadius="16,16,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="20,0">
                        <TextBlock Text="❓" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Довідка" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="✕" Style="{StaticResource CloseButtonStyle}" Click="Close_Click" Margin="0,0,12,0" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                </Grid>
            </Border>

            <!-- КОНТЕНТ -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24">
                <StackPanel>
                    <!-- ПРО ПРОГРАМУ -->
                    <Border Background="{DynamicResource BackgroundSecondary}" CornerRadius="12" Padding="24" Margin="0,0,0,20" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="⚡ MediaVault" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryLight}"/>
                            <TextBlock Text="Каталогізатор медіафайлів з аналізом безпеки" Foreground="{DynamicResource TextSecondaryLight}" FontSize="14" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- ЯК КОРИСТУВАТИСЬ -->
                    <TextBlock Text="ЯК КОРИСТУВАТИСЬ" Foreground="{DynamicResource TextSecondaryLight}" FontSize="11" FontWeight="Bold" Margin="0,0,0,12"/>

                    <Border Background="{DynamicResource BackgroundSecondary}" CornerRadius="12" Padding="24" Margin="0,0,0,20" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="1️⃣ Додати папку" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryLight}" Margin="0,0,0,6"/>
                            <TextBlock Text="Натисніть '📁 Додати папку' у верхній панелі та виберіть папку з вашими файлами." Foreground="{DynamicResource TextSecondaryLight}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,16"/>

                            <TextBlock Text="2️⃣ Переглянути колекцію" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryLight}" Margin="0,0,0,6"/>
                            <TextBlock Text="Програма просканує папку, знайде всі медіафайли та автоматично завантажить обкладинки й описи." Foreground="{DynamicResource TextSecondaryLight}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,16"/>

                            <TextBlock Text="3️⃣ Клікнути на картку" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryLight}" Margin="0,0,0,6"/>
                            <TextBlock Text="Відкриється детальне вікно з описом, рейтингом та можливістю вибрати обкладинку вручну." Foreground="{DynamicResource TextSecondaryLight}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,16"/>

                            <TextBlock Text="4️⃣ Використати пошук" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryLight}" Margin="0,0,0,6"/>
                            <TextBlock Text="Введіть назву, виконавця або жанр у полі пошуку — картки відфільтруються автоматично." Foreground="{DynamicResource TextSecondaryLight}" FontSize="13" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- ФУНКЦІЇ -->
                    <TextBlock Text="ОСНОВНІ ФУНКЦІЇ" Foreground="{DynamicResource TextSecondaryLight}" FontSize="11" FontWeight="Bold" Margin="0,0,0,12"/>

                    <Border Background="{DynamicResource BackgroundSecondary}" CornerRadius="12" Padding="24" Margin="0,0,0,20" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="📊" FontSize="20" Margin="0,0,12,0"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Статистика" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryLight}"/>
                                    <TextBlock Text="Графіки розподілу за типами, роками, жанрами." Foreground="{DynamicResource TextSecondaryLight}" FontSize="12"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🔍" FontSize="20" Margin="0,0,12,0"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Пошук дублікатів" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryLight}"/>
                                    <TextBlock Text="Знаходить однакові файли за хешем та дозволяє їх видалити." Foreground="{DynamicResource TextSecondaryLight}" FontSize="12"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="📄" FontSize="20" Margin="0,0,12,0"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Експорт звіту" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryLight}"/>
                                    <TextBlock Text="Генерує HTML-звіт з усією колекцією та статистикою." Foreground="{DynamicResource TextSecondaryLight}" FontSize="12"/>
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🖼️" FontSize="20" Margin="0,0,12,0"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Ручний вибір обкладинки" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryLight}"/>
                                    <TextBlock Text="Якщо обкладинка не знайдена — виберіть її вручну з файлу або URL." Foreground="{DynamicResource TextSecondaryLight}" FontSize="12"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ГАРЯЧІ КЛАВІШІ -->
                    <TextBlock Text="ГАРЯЧІ КЛАВІШІ" Foreground="{DynamicResource TextSecondaryLight}" FontSize="11" FontWeight="Bold" Margin="0,0,0,12"/>

                    <Border Background="{DynamicResource BackgroundSecondary}" CornerRadius="12" Padding="24" Margin="0,0,0,20" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{DynamicResource InputBackground}" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left">
                                    <TextBlock Text="Ctrl + F" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryLight}"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Фокус на пошук" Foreground="{DynamicResource TextSecondaryLight}" FontSize="13" VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{DynamicResource InputBackground}" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left">
                                    <TextBlock Text="Ctrl + O" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryLight}"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Додати папку" Foreground="{DynamicResource TextSecondaryLight}" FontSize="13" VerticalAlignment="Center"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{DynamicResource InputBackground}" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left">
                                    <TextBlock Text="Esc" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryLight}"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Закрити вікно" Foreground="{DynamicResource TextSecondaryLight}" FontSize="13" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ВЕРСІЯ -->
                    <Border Background="#E8F5E9" CornerRadius="12" Padding="20" BorderBrush="{DynamicResource AccentColor}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Версія 2.0.0" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentColor}"/>
                            <TextBlock Text="Курсова робота з дисципліни 'Конструювання програмного забезпечення'" Foreground="{DynamicResource TextSecondaryLight}" FontSize="12" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>