<Window x:Class="MediaVault.Views.CategorySelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вибір категорії" 
        Height="300" 
        Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1A1A1A">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Виберіть категорію для видалення:" 
                   Foreground="White" FontSize="14" Margin="0,0,0,16"/>

        <ListBox x:Name="CategoryList" Grid.Row="1" 
                 Background="#2A2A2A" Foreground="White" 
                 BorderThickness="0" Padding="8">
            <ListBoxItem Content="🎬 Фільми" Tag="Film"/>
            <ListBoxItem Content="📱 Короткі відео" Tag="ShortVideo"/>
            <ListBoxItem Content="📖 Книги" Tag="Book"/>
            <ListBoxItem Content="🎵 Музика" Tag="Music"/>
            <ListBoxItem Content="🖼️ Зображення" Tag="Image"/>
            <ListBoxItem Content="📄 Документи" Tag="Document"/>
            <ListBoxItem Content="💻 Програми" Tag="Program"/>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Скасувати" Click="Cancel_Click" Width="100" Height="36" Margin="0,0,8,0"
                    Background="#333333" Foreground="White" BorderThickness="0"/>
            <Button Content="Видалити" Click="Delete_Click" Width="100" Height="36"
                    Background="#FF3B30" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>